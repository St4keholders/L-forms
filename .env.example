# Fuente de datos: "mock" (memoria + localStorage, sin backend) o "supabase"
NEXT_PUBLIC_DATA_SOURCE=mock

# Credenciales de Supabase. La anon key es publica por diseno (la protege RLS).
# NUNCA pongas aqui la service_role key ni la subas al repositorio.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY

# Bucket de Storage para archivos adjuntos y firmas
NEXT_PUBLIC_SUPABASE_BUCKET=l-forms

# Integracion con Google Sheets / Drive OAuth
SHEETS_SYNC_ENABLED=true
NEXT_PUBLIC_SHEETS_SYNC_ENABLED=true

# Credenciales de Google OAuth 2.0 (Google Cloud Console)
GOOGLE_CLIENT_ID=TU_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=TU_GOOGLE_CLIENT_SECRET

# URI de redireccionamiento (opcional en local, recomendada en Vercel)
# GOOGLE_REDIRECT_URI=https://tu-app.vercel.app/api/auth/google/callback
